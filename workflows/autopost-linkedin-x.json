    {
      "parameters": {
        "jsCode": "// Rota el estilo según el id del tema, así cada post se ve distinto\nconst estilos = [\n  { nombre: 'Póster editorial', persona: true, desc: 'titular gigante en dos tonos ocupando la mitad superior, la persona posando sentado en una silla moderna, fondo de color sólido intenso, mucho espacio negativo' },\n  { nombre: 'Portada de diario', persona: true, desc: 'la persona sentado sosteniendo un diario abierto que tapa parte de su cuerpo, el titular impreso en la portada del diario en tipografía condensada negra y de color' },\n  { nombre: 'Infografía de recurso', persona: false, desc: 'titular grande a la izquierda con etiqueta superior tipo badge, a la derecha un diagrama con íconos conectados por líneas punteadas, abajo una franja con 5 o 6 beneficios con íconos lineales' },\n  { nombre: 'Personaje sticker', persona: true, desc: 'la persona recortado como sticker con borde blanco grueso, cabeza levemente grande estilo caricatura, flechas dibujadas a mano y 3 anotaciones cortas alrededor, fondo liso oscuro' },\n  { nombre: 'Tipografía gigante', persona: true, desc: 'una palabra clave enorme en color detrás de la persona que aparece delante tomando un café, frase corta arriba a la izquierda, fondo claro con textura de papel' },\n  { nombre: 'Escritorio cenital', persona: false, desc: 'vista desde arriba de manos trabajando en un laptop sobre escritorio claro, con taza y celular, titular grande arriba con una palabra resaltada en bloque de color, 3 etiquetas de texto tipo cinta sobre la escena' },\n  { nombre: 'Tipografía con fotos', persona: true, desc: 'frase grande en tipografía negra sobre fondo gris claro, con pequeñas fotos rectangulares de la persona trabajando insertadas entre las palabras' },\n  { nombre: 'Mockup de producto', persona: true, desc: 'titular grande con palabras en cursiva destacada, la persona relajado en un puff a un lado y un celular o laptop flotando mostrando una interfaz, fondo degradado suave, íconos 3D pequeños' },\n];\nconst fila = $('Siguiente tema').first().json;\nconst estilo = estilos[fila.id % estilos.length];\nreturn [{ json: { ...fila, estilo: estilo.nombre, estilo_desc: estilo.desc, con_persona: estilo.persona } }];"
      },
      "id": "010b9644-60cd-44a7-b08d-8ef8390a37dc",
      "name": "Elegir estilo",
