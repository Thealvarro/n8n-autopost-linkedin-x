        "jsonBody": "={{ JSON.stringify({ author: 'urn:li:person:TU_ID_DE_LINKEDIN', commentary: $('Preparar imagen').first().json.commentary, visibility: 'PUBLIC', distribution: { feedDistribution: 'MAIN_FEED', targetEntities: [], thirdPartyDistributionChannels: [] }, content: { media: { id: $('Preparar imagen').first().json.image, altText: $('Siguiente tema').first().json.tema } }, lifecycleState: 'PUBLISHED', isReshareDisabledByAuthor: false }) }}",
