        "jsCode": "// Convierte la respuesta del director en campos usables\nconst crudo = ($json.output?.[0]?.content?.[0]?.text ?? '').replace(/^```(json)?|```$/g, '').trim();\nconst brief = JSON.parse(crudo);\nconst base = $('Elegir estilo').first().json;\nreturn [{ json: { ...brief, estilo: base.estilo, con_persona: base.con_persona } }];"
      },
