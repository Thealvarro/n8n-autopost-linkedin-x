    {
      "parameters": {
        "jsCode": "// LinkedIn usa formato 'little text': hay que escapar sus caracteres reservados\nconst crudo = $('Armar texto').first().json.texto;\nconst escapado = crudo.replace(/[\\\\|{}@\\[\\]()<>*_~]/g, (c) => '\\\\' + c);\nconst commentary = escapado.replace(/#([\\p{L}\\p{N}_]+)/gu, '{hashtag|\\\\#|$1}');\nreturn [{\n  json: { uploadUrl: $json.value.uploadUrl, image: $json.value.image, commentary },\n  binary: $('Crear imagen').first().binary,\n}];"
      },
